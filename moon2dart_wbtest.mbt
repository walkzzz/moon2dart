///|
/// 根包白盒测试 — transpile 入口正确性。

///|
test "transpile single fn" {
  let prog = [@ast.DFn("id", [("x", @ast.MInt)], @ast.MInt, @ast.EVar("x"))]
  let result = transpile(prog)
  assert_true(result.contains("Generated by moon2dart"))
  assert_true(result.contains("int id(int x)"))
  assert_true(result.contains("return x;"))
}

///|
test "transpile multiple decls" {
  let prog = [
    @ast.DEnum("Color", ["Red", "Green", "Blue"]),
    @ast.DStruct("Point", [("x", @ast.MInt), ("y", @ast.MInt)]),
    @ast.DFn(
      "add",
      [("a", @ast.MInt), ("b", @ast.MInt)],
      @ast.MInt,
      @ast.EBinOp("+", @ast.EVar("a"), @ast.EVar("b")),
    ),
  ]
  let result = transpile(prog)
  assert_true(result.contains("sealed class Color"))
  assert_true(result.contains("class Point"))
  assert_true(result.contains("int add(int a, int b)"))
}

///|
test "transpile_decl convenience" {
  let fn_ = @ast.DFn(
    "double",
    [("x", @ast.MInt)],
    @ast.MInt,
    @ast.EBinOp("*", @ast.EVar("x"), @ast.EInt(2)),
  )
  let result = transpile_decl(fn_)
  assert_true(result.contains("int double(int x)"))
  assert_true(result.contains("return x * 2;"))
}

///|
test "transpile_expr convenience" {
  let expr = @ast.EBinOp("+", @ast.EInt(1), @ast.EInt(2))
  assert_eq(transpile_expr(expr), "1 + 2")
}

///|
test "transpile_type convenience" {
  assert_eq(transpile_type(@ast.MInt), "int")
  assert_eq(transpile_type(@ast.MArray(@ast.MString)), "List<String>")
  assert_eq(transpile_type(@ast.MOption(@ast.MBool)), "bool?")
}
