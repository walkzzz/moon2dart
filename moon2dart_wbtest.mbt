///|
/// 根包白盒测试 — transpile 入口正确性。

///|
test "transpile single fn" {
  let prog = [@ast.DFn("id", [("x", @ast.MInt)], @ast.MInt, @ast.EVar("x"))]
  let result = transpile(prog)
  assert_true(result.contains("Generated by moon2dart"))
  assert_true(result.contains("int id(int x)"))
  assert_true(result.contains("return x;"))
}

///|
test "transpile multiple decls" {
  let prog = [
    @ast.DEnum("Color", ["Red", "Green", "Blue"]),
    @ast.DStruct("Point", [("x", @ast.MInt), ("y", @ast.MInt)]),
    @ast.DFn(
      "add",
      [("a", @ast.MInt), ("b", @ast.MInt)],
      @ast.MInt,
      @ast.EBinOp("+", @ast.EVar("a"), @ast.EVar("b")),
    ),
  ]
  let result = transpile(prog)
  assert_true(result.contains("sealed class Color"))
  assert_true(result.contains("class Point"))
  assert_true(result.contains("int add(int a, int b)"))
}

///|
test "transpile_decl convenience" {
  let fn_ = @ast.DFn(
    "double",
    [("x", @ast.MInt)],
    @ast.MInt,
    @ast.EBinOp("*", @ast.EVar("x"), @ast.EInt(2)),
  )
  let result = transpile_decl(fn_)
  assert_true(result.contains("int double(int x)"))
  assert_true(result.contains("return x * 2;"))
}

///|
test "transpile_expr convenience" {
  let expr = @ast.EBinOp("+", @ast.EInt(1), @ast.EInt(2))
  assert_eq(transpile_expr(expr), "1 + 2")
}

///|
test "transpile_type convenience" {
  assert_eq(transpile_type(@ast.MInt), "int")
  assert_eq(transpile_type(@ast.MArray(@ast.MString)), "List<String>")
  assert_eq(transpile_type(@ast.MOption(@ast.MBool)), "bool?")
}

///|
/// 管线测试：transpile_source 从源码到 Dart。

///|
test "transpile_source empty" {
  let result = transpile_source("")
  assert_true(result.contains("Generated by moon2dart"))
}

///|
test "transpile_source fn" {
  let src = "fn id(x : Int) -> Int { x }"
  let result = transpile_source(src)
  assert_true(result.contains("int id(int x)"))
  assert_true(result.contains("return x;"))
}

///|
test "transpile_source fn_add" {
  let src = "fn add(a : Int, b : Int) -> Int { a + b }"
  let result = transpile_source(src)
  assert_true(result.contains("int add(int a, int b)"))
  assert_true(result.contains("return a + b;"))
}

///|
test "transpile_source struct" {
  let src = "struct Point { x : Int, y : Int }"
  let result = transpile_source(src)
  assert_true(result.contains("class Point"))
  assert_true(result.contains("int x;"))
  assert_true(result.contains("int y;"))
}

///|
test "transpile_source enum" {
  let src = "enum Color { Red, Green, Blue }"
  let result = transpile_source(src)
  assert_true(result.contains("sealed class Color"))
  assert_true(result.contains("class Red extends Color"))
  assert_true(result.contains("class Green extends Color"))
  assert_true(result.contains("class Blue extends Color"))
}

///|
test "transpile_source multi_decl" {
  let src = "fn id(x : Int) -> Int { x }\nstruct Foo { a : Int }\nenum Bar { A, B }"
  let result = transpile_source(src)
  assert_true(result.contains("int id(int x)"))
  assert_true(result.contains("class Foo"))
  assert_true(result.contains("sealed class Bar"))
}

///|
test "transpile_source string_expr" {
  let src = "fn greet() -> String { \"hello\" }"
  let result = transpile_source(src)
  assert_true(result.contains("String greet()"))
  assert_true(result.contains("return \"hello\";"))
}

///|
test "transpile_source call_expr" {
  let src = "fn call_it() -> Int { foo(1, 2) }"
  let result = transpile_source(src)
  assert_true(result.contains("return foo(1, 2);"))
}

///|
/// v0.3.0 trait 转换测试。

///|
test "transpile_source trait" {
  let src = "trait Drawable { fn draw() -> Unit; fn area() -> Double; }"
  let result = transpile_source(src)
  assert_true(result.contains("abstract class Drawable"))
  assert_true(result.contains("void draw();"))
  assert_true(result.contains("double area();"))
}

///|
test "transpile_source trait_with_params" {
  let src = "trait Comparable { fn compare(other : Int) -> Int; }"
  let result = transpile_source(src)
  assert_true(result.contains("abstract class Comparable"))
  assert_true(result.contains("int compare(int other);"))
}

///|
test "transpile_source trait_and_struct" {
  let src = "trait Drawable { fn draw() -> Unit; }\nstruct Circle { r : Double }"
  let result = transpile_source(src)
  assert_true(result.contains("abstract class Drawable"))
  assert_true(result.contains("class Circle"))
}
