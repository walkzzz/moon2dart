///|
/// 根包白盒测试 — transpile 入口正确性。

///|
test "transpile single fn" {
  let prog = [@ast.DFn("id", [], [("x", @ast.MInt)], @ast.MInt, @ast.EVar("x"))]
  let result = transpile(prog)
  assert_true(result.contains("Generated by moon2dart"))
  assert_true(result.contains("int id(int x)"))
  assert_true(result.contains("return x;"))
}

///|
test "transpile multiple decls" {
  let prog = [
    @ast.DEnum("Color", ["Red", "Green", "Blue"]),
    @ast.DStruct("Point", [], [("x", @ast.MInt), ("y", @ast.MInt)], []),
    @ast.DFn(
      "add",
      [],
      [("a", @ast.MInt), ("b", @ast.MInt)],
      @ast.MInt,
      @ast.EBinOp("+", @ast.EVar("a"), @ast.EVar("b")),
    ),
  ]
  let result = transpile(prog)
  assert_true(result.contains("sealed class Color"))
  assert_true(result.contains("class Point"))
  assert_true(result.contains("int add(int a, int b)"))
}

///|
test "transpile_decl convenience" {
  let fn_ = @ast.DFn(
    "double",
    [],
    [("x", @ast.MInt)],
    @ast.MInt,
    @ast.EBinOp("*", @ast.EVar("x"), @ast.EInt(2)),
  )
  let result = transpile_decl(fn_)
  assert_true(result.contains("int double(int x)"))
  assert_true(result.contains("return x * 2;"))
}

///|
test "transpile_expr convenience" {
  let expr = @ast.EBinOp("+", @ast.EInt(1), @ast.EInt(2))
  assert_eq(transpile_expr(expr), "1 + 2")
}

///|
test "transpile_type convenience" {
  assert_eq(transpile_type(@ast.MInt), "int")
  assert_eq(transpile_type(@ast.MArray(@ast.MString)), "List<String>")
  assert_eq(transpile_type(@ast.MOption(@ast.MBool)), "bool?")
}

///|
/// 管线测试：transpile_source 从源码到 Dart。

///|
test "transpile_source empty" {
  let result = try transpile_source("") catch {
    @ast.Moon2DartError::ParseError(_) => "parse error"
    _ => "other error"
  }
  assert_eq(result, "parse error")
}

///|
test "transpile_source fn" {
  let src = "fn id(x : Int) -> Int { x }"
  let result = transpile_source(src)
  assert_true(result.contains("int id(int x)"))
  assert_true(result.contains("return x;"))
}

///|
test "transpile_source fn_add" {
  let src = "fn add(a : Int, b : Int) -> Int { a + b }"
  let result = transpile_source(src)
  assert_true(result.contains("int add(int a, int b)"))
  assert_true(result.contains("return a + b;"))
}

///|
test "transpile_source struct" {
  let src = "struct Point { x : Int, y : Int }"
  let result = transpile_source(src)
  assert_true(result.contains("class Point"))
  assert_true(result.contains("int x;"))
  assert_true(result.contains("int y;"))
}

///|
test "transpile_source enum" {
  let src = "enum Color { Red, Green, Blue }"
  let result = transpile_source(src)
  assert_true(result.contains("sealed class Color"))
  assert_true(result.contains("class Red extends Color"))
  assert_true(result.contains("class Green extends Color"))
  assert_true(result.contains("class Blue extends Color"))
}

///|
test "transpile_source multi_decl" {
  let src = "fn id(x : Int) -> Int { x }\nstruct Foo { a : Int }\nenum Bar { A, B }"
  let result = transpile_source(src)
  assert_true(result.contains("int id(int x)"))
  assert_true(result.contains("class Foo"))
  assert_true(result.contains("sealed class Bar"))
}

///|
test "transpile_source string_expr" {
  let src = "fn greet() -> String { \"hello\" }"
  let result = transpile_source(src)
  assert_true(result.contains("String greet()"))
  assert_true(result.contains("return \"hello\";"))
}

///|
test "transpile_source call_expr" {
  let src = "fn call_it() -> Int { foo(1, 2) }"
  let result = transpile_source(src)
  assert_true(result.contains("return foo(1, 2);"))
}

///|
/// v0.3.0 trait 转换测试。

///|
test "transpile_source trait" {
  let src = "trait Drawable { fn draw() -> Unit; fn area() -> Double; }"
  let result = transpile_source(src)
  assert_true(result.contains("abstract class Drawable"))
  assert_true(result.contains("void draw();"))
  assert_true(result.contains("double area();"))
}

///|
test "transpile_source trait_with_params" {
  let src = "trait Comparable { fn compare(other : Int) -> Int; }"
  let result = transpile_source(src)
  assert_true(result.contains("abstract class Comparable"))
  assert_true(result.contains("int compare(int other);"))
}

///|
test "transpile_source trait_and_struct" {
  let src = "trait Drawable { fn draw() -> Unit; }\nstruct Circle { r : Double }"
  let result = transpile_source(src)
  assert_true(result.contains("abstract class Drawable"))
  assert_true(result.contains("class Circle"))
}

///|
/// v0.3.0 match 转换测试。

///|
test "transpile_source match_basic" {
  let src = "fn classify(x : Int) -> Int { match x { 1 => 10, _ => 0 } }"
  let result = transpile_source(src)
  assert_true(result.contains("switch (x)"))
  assert_true(result.contains("1 => 10"))
  assert_true(result.contains("_ => 0"))
}

///|
test "transpile_source match_ctor" {
  let src = "fn get_color(s : Color) -> Int { match s { Red => 1, Green => 2, Blue => 3 } }"
  let result = transpile_source(src)
  assert_true(result.contains("switch (s)"))
  assert_true(result.contains("Red() => 1"))
  assert_true(result.contains("Green() => 2"))
}

///|
/// v0.3.0 derive 生成管线测试。

///|
test "transpile_source struct_derive_debug" {
  let src = "struct Point derive(Debug) { x : Int, y : Int }"
  let result = transpile_source(src)
  assert_true(result.contains("class Point"))
  assert_true(result.contains("toString()"))
  assert_true(result.contains("Point(x: $x, y: $y)"))
}

///|
test "transpile_source struct_derive_eq" {
  let src = "struct Point derive(Eq) { x : Int, y : Int }"
  let result = transpile_source(src)
  assert_true(result.contains("operator=="))
  assert_true(result.contains("other is Point"))
}

///|
test "transpile_source struct_derive_all" {
  let src = "struct Point derive(Debug, Eq, Compare) { x : Int, y : Int }"
  let result = transpile_source(src)
  assert_true(result.contains("toString()"))
  assert_true(result.contains("operator=="))
  assert_true(result.contains("compareTo"))
}

///|
/// v0.3.0 S4 impl 转换管线测试。

///|
test "transpile_source impl" {
  let src = "trait Drawable { fn draw() -> Unit; }\nimpl Drawable for Circle { fn draw() -> Unit { 0 } }"
  let result = transpile_source(src)
  assert_true(result.contains("abstract class Drawable"))
  assert_true(result.contains("class Circle implements Drawable"))
  assert_true(result.contains("void draw()"))
}

///|
test "transpile_source struct_with_impl" {
  let src = "trait Drawable { fn draw() -> Unit; }\nstruct Circle { r : Double }\nimpl Drawable for Circle { fn draw() -> Unit { 0 } }"
  let result = transpile_source(src)
  assert_true(result.contains("abstract class Drawable"))
  assert_true(result.contains("class Circle implements Drawable"))
  assert_true(result.contains("double r;"))
  assert_true(result.contains("void draw()"))
}

///|
test "transpile_source impl_with_params" {
  let src = "trait Comparable { fn compare(other : Int) -> Int; }\nimpl Comparable for Foo { fn compare(other : Int) -> Int { 0 } }"
  let result = transpile_source(src)
  assert_true(result.contains("class Foo implements Comparable"))
  assert_true(result.contains("int compare(int other)"))
}

///|
/// v0.5.0 S1 async/await 管线测试。

///|
test "transpile_source async_fn" {
  let src = "async fn fetchData() -> String { \"hello\" }"
  let result = transpile_source(src)
  assert_true(result.contains("Future<String> fetchData() async"))
  assert_true(result.contains("return \"hello\";"))
}

///|
test "transpile_source async_fn_with_params" {
  let src = "async fn compute(x : Int) -> Int { x + 1 }"
  let result = transpile_source(src)
  assert_true(result.contains("Future<int> compute(int x) async"))
  assert_true(result.contains("return x + 1;"))
}

///|
test "transpile_source async_fn_with_await" {
  let src = "async fn getData() -> String { await fetch() }"
  let result = transpile_source(src)
  assert_true(result.contains("Future<String> getData() async"))
  assert_true(result.contains("return await fetch();"))
}

///|
test "transpile_source async_and_sync" {
  let src = "async fn fetchData() -> String { \"data\" }\nfn process(x : Int) -> Int { x }"
  let result = transpile_source(src)
  assert_true(result.contains("Future<String> fetchData() async"))
  assert_true(result.contains("int process(int x)"))
}

///|
/// v0.5.0 S2 Option null safety 管线测试。

///|
test "transpile_source option_type" {
  let src = "fn maybe(x : Int) -> Option[Int] { Some(x) }"
  let result = transpile_source(src)
  assert_true(result.contains("int? maybe(int x)"))
  assert_true(result.contains("return x;"))
}

///|
test "transpile_source none_value" {
  let src = "fn nothing() -> Option[Int] { None }"
  let result = transpile_source(src)
  assert_true(result.contains("int? nothing()"))
  assert_true(result.contains("return null;"))
}

///|
test "transpile_source match_option" {
  let src = "fn unwrap(opt : Option[Int]) -> Int { match opt { Some(x) => x, None => 0 } }"
  let result = transpile_source(src)
  assert_true(result.contains("switch (opt)"))
  assert_true(result.contains("null => 0"))
  assert_true(result.contains("var x => x"))
}

///|
test "transpile_source match_option_none_first" {
  let src = "fn check(opt : Option[Int]) -> Int { match opt { None => 0, Some(x) => x } }"
  let result = transpile_source(src)
  assert_true(result.contains("switch (opt)"))
  assert_true(result.contains("null => 0"))
  assert_true(result.contains("var x => x"))
}

///|
/// v0.5.0 S3 Result sealed class 管线测试。

///|
test "transpile_source result_type" {
  let src = "fn parse() -> Result[Int, String] { Ok(42) }"
  let result = transpile_source(src)
  assert_true(result.contains("sealed class Result<T, E>"))
  assert_true(result.contains("class Ok<T, E> extends Result<T, E>"))
  assert_true(result.contains("class Err<T, E> extends Result<T, E>"))
  assert_true(result.contains("Result<int, String> parse()"))
  assert_true(result.contains("return Ok(42);"))
}

///|
test "transpile_source result_err" {
  let src = "fn fail() -> Result[Int, String] { Err(\"error\") }"
  let result = transpile_source(src)
  assert_true(result.contains("sealed class Result<T, E>"))
  assert_true(result.contains("return Err(\"error\");"))
}

///|
test "transpile_source match_result" {
  let src = "fn handle(r : Result[Int, String]) -> Int { match r { Ok(v) => v, Err(e) => 0 } }"
  let result = transpile_source(src)
  assert_true(result.contains("sealed class Result<T, E>"))
  assert_true(result.contains("switch (r)"))
  assert_true(result.contains("Ok(var v) => v"))
  assert_true(result.contains("Err(var e) => 0"))
}

///|
test "transpile_source no_result_class" {
  let src = "fn add(a : Int, b : Int) -> Int { a + b }"
  let result = transpile_source(src)
  assert_true(!result.contains("sealed class Result"))
}

