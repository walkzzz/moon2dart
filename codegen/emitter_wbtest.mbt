///|
/// codegen 白盒测试 — 代码发射正确性。

///|
test "emit_dart_expr literals" {
  assert_eq(emit_dart_expr(@ast.EInt(42)), "42")
  assert_eq(emit_dart_expr(@ast.EDouble(3.14)), "3.14")
  assert_eq(emit_dart_expr(@ast.EBool(true)), "true")
  assert_eq(emit_dart_expr(@ast.EBool(false)), "false")
  assert_eq(emit_dart_expr(@ast.EString("hello")), "\"hello\"")
  assert_eq(emit_dart_expr(@ast.EVar("x")), "x")
}

///|
test "emit_dart_expr call" {
  let call = @ast.ECall("add", [@ast.EInt(1), @ast.EInt(2)])
  assert_eq(emit_dart_expr(call), "add(1, 2)")
}

///|
test "emit_dart_expr binop" {
  let binop = @ast.EBinOp("+", @ast.EVar("a"), @ast.EVar("b"))
  assert_eq(emit_dart_expr(binop), "a + b")
}

///|
test "emit_dart_expr if" {
  let if_ = @ast.EIf(@ast.EBool(true), @ast.EInt(1), @ast.EInt(0))
  assert_eq(emit_dart_expr(if_), "true ? 1 : 0")
}

///|
test "emit_dart_pattern" {
  assert_eq(emit_dart_pattern(@ast.PVar("x")), "var x")
  assert_eq(emit_dart_pattern(@ast.PInt(42)), "42")
  assert_eq(emit_dart_pattern(@ast.PString("hi")), "\"hi\"")
  assert_eq(emit_dart_pattern(@ast.PWild), "_")
  assert_eq(
    emit_dart_pattern(@ast.PCtor("Some", [@ast.PVar("x")])),
    "Some(var x)",
  )
}

///|
test "emit_dart_decl fn" {
  let fn_ = @ast.DFn(
    "add",
    [("a", @ast.MInt), ("b", @ast.MInt)],
    @ast.MInt,
    @ast.EBinOp("+", @ast.EVar("a"), @ast.EVar("b")),
  )
  let expected = "int add(int a, int b) {\n  return a + b;\n}"
  assert_eq(emit_dart_decl(fn_), expected)
}

///|
test "emit_dart_decl struct" {
  let struct_ = @ast.DStruct("Point", [("x", @ast.MInt), ("y", @ast.MInt)], [])
  let expected = "class Point {\n  int x;\n  int y;\n  Point({required this.x, required this.y});\n}"
  assert_eq(emit_dart_decl(struct_), expected)
}

///|
test "emit_dart_decl enum" {
  let enum_ = @ast.DEnum("Color", ["Red", "Green", "Blue"])
  let expected = "sealed class Color {}\nclass Red extends Color {}\nclass Green extends Color {}\nclass Blue extends Color {}"
  assert_eq(emit_dart_decl(enum_), expected)
}

///|
test "emit_dart_program" {
  let prog = [
    @ast.DFn(
      "square",
      [("x", @ast.MInt)],
      @ast.MInt,
      @ast.EBinOp("*", @ast.EVar("x"), @ast.EVar("x")),
    ),
  ]
  let result = emit_dart_program(prog)
  assert_true(result.contains("Generated by moon2dart"))
  assert_true(result.contains("int square(int x)"))
  assert_true(result.contains("return x * x;"))
}

///|
test "emit_dart_decl trait" {
  let trait_ = @ast.DTrait("Drawable", [
    { name: "draw", params: [], ret_type: @ast.MUnit, },
    { name: "area", params: [], ret_type: @ast.MDouble, },
  ])
  let result = emit_dart_decl(trait_)
  assert_true(result.contains("abstract class Drawable"))
  assert_true(result.contains("void draw();"))
  assert_true(result.contains("double area();"))
}

///|
test "emit_dart_decl trait_with_params" {
  let trait_ = @ast.DTrait("Comparable", [
    { name: "compare", params: [("other", @ast.MInt)], ret_type: @ast.MInt, },
  ])
  let result = emit_dart_decl(trait_)
  assert_true(result.contains("abstract class Comparable"))
  assert_true(result.contains("int compare(int other);"))
}

///|
test "emit_dart_expr match_basic" {
  let m = @ast.EMatch(@ast.EVar("x"), [
    (@ast.PInt(1), @ast.EVar("a")),
    (@ast.PWild, @ast.EVar("b")),
  ])
  let result = emit_dart_expr(m)
  assert_true(result.contains("switch (x)"))
  assert_true(result.contains("1 => a"))
  assert_true(result.contains("_ => b"))
}

///|
test "emit_dart_expr match_ctor" {
  let m = @ast.EMatch(@ast.EVar("s"), [
    (@ast.PCtor("Red", []), @ast.EInt(1)),
    (@ast.PCtor("Green", []), @ast.EInt(2)),
    (@ast.PWild, @ast.EInt(0)),
  ])
  let result = emit_dart_expr(m)
  assert_true(result.contains("switch (s)"))
  assert_true(result.contains("Red() => 1"))
  assert_true(result.contains("Green() => 2"))
  assert_true(result.contains("_ => 0"))
}

///|
test "emit_dart_expr match_ctor_with_args" {
  let m = @ast.EMatch(@ast.EVar("e"), [
    (@ast.PCtor("Point", [@ast.PVar("x"), @ast.PVar("y")]), @ast.EVar("x")),
    (@ast.PWild, @ast.EInt(0)),
  ])
  let result = emit_dart_expr(m)
  assert_true(result.contains("switch (e)"))
  assert_true(result.contains("Point(var x, var y) => x"))
  assert_true(result.contains("_ => 0"))
}

///|
test "emit_dart_pattern wild" {
  assert_eq(emit_dart_pattern(@ast.PWild), "_")
}

///|
test "emit_dart_pattern ctor_empty" {
  assert_eq(emit_dart_pattern(@ast.PCtor("Red", [])), "Red()")
}

///|
test "emit_dart_pattern ctor_with_args" {
  let p = @ast.PCtor("Point", [@ast.PVar("x"), @ast.PVar("y")])
  assert_eq(emit_dart_pattern(p), "Point(var x, var y)")
}

///|
test "emit_dart_decl struct_derive_debug" {
  let s = @ast.DStruct("Point", [("x", @ast.MInt), ("y", @ast.MInt)], ["Debug"])
  let result = emit_dart_decl(s)
  assert_true(result.contains("class Point"))
  assert_true(result.contains("toString()"))
  assert_true(result.contains("Point(x: $x, y: $y)"))
}

///|
test "emit_dart_decl struct_derive_eq" {
  let s = @ast.DStruct("Point", [("x", @ast.MInt), ("y", @ast.MInt)], ["Eq"])
  let result = emit_dart_decl(s)
  assert_true(result.contains("operator=="))
  assert_true(result.contains("other is Point"))
  assert_true(result.contains("other.x == x"))
  assert_true(result.contains("other.y == y"))
}

///|
test "emit_dart_decl struct_derive_compare" {
  let s = @ast.DStruct("Point", [("x", @ast.MInt), ("y", @ast.MInt)], [
    "Compare",
  ])
  let result = emit_dart_decl(s)
  assert_true(result.contains("compareTo"))
  assert_true(result.contains("x.compareTo(other.x)"))
  assert_true(result.contains("y.compareTo(other.y)"))
}

///|
test "emit_dart_decl struct_derive_all" {
  let s = @ast.DStruct("Point", [("x", @ast.MInt), ("y", @ast.MInt)], [
    "Debug", "Eq", "Compare",
  ])
  let result = emit_dart_decl(s)
  assert_true(result.contains("toString()"))
  assert_true(result.contains("operator=="))
  assert_true(result.contains("compareTo"))
}

///|
test "emit_dart_decl struct_no_derive" {
  let s = @ast.DStruct("Point", [("x", @ast.MInt), ("y", @ast.MInt)], [])
  let result = emit_dart_decl(s)
  assert_true(result.contains("class Point"))
  assert_true(!result.contains("toString()"))
  assert_true(!result.contains("operator=="))
  assert_true(!result.contains("compareTo"))
}

///|
/// v0.3.0 S4 impl 转换测试。

///|
test "emit_dart_decl impl" {
  let impl_ = @ast.DImpl("Drawable", "Circle", [
    { name: "draw", params: [], ret_type: @ast.MUnit, body: @ast.EInt(0), },
  ])
  let result = emit_dart_decl(impl_)
  assert_true(result.contains("class Circle implements Drawable"))
  assert_true(result.contains("void draw()"))
}

///|
test "emit_dart_decl impl_with_params" {
  let impl_ = @ast.DImpl("Comparable", "Circle", [
    {
      name: "compare",
      params: [("other", @ast.MCustom("Circle"))],
      ret_type: @ast.MInt,
      body: @ast.EInt(0),
    },
  ])
  let result = emit_dart_decl(impl_)
  assert_true(result.contains("class Circle implements Comparable"))
  assert_true(result.contains("int compare(Circle other)"))
}

///|
test "emit_dart_program struct_with_impl" {
  let prog = [
    @ast.DTrait("Drawable", [
      { name: "draw", params: [], ret_type: @ast.MUnit, },
    ]),
    @ast.DStruct("Circle", [("r", @ast.MDouble)], []),
    @ast.DImpl("Drawable", "Circle", [
      { name: "draw", params: [], ret_type: @ast.MUnit, body: @ast.EInt(0), },
    ]),
  ]
  let result = emit_dart_program(prog)
  assert_true(result.contains("abstract class Drawable"))
  assert_true(result.contains("class Circle implements Drawable"))
  assert_true(result.contains("void draw()"))
}

///|
test "emit_dart_program struct_with_multi_impl" {
  let prog = [
    @ast.DTrait("Drawable", [
      { name: "draw", params: [], ret_type: @ast.MUnit, },
    ]),
    @ast.DTrait("Comparable", [
      {
        name: "compare",
        params: [("other", @ast.MCustom("Circle"))],
        ret_type: @ast.MInt,
      },
    ]),
    @ast.DStruct("Circle", [("r", @ast.MDouble)], []),
    @ast.DImpl("Drawable", "Circle", [
      { name: "draw", params: [], ret_type: @ast.MUnit, body: @ast.EInt(0), },
    ]),
    @ast.DImpl("Comparable", "Circle", [
      {
        name: "compare",
        params: [("other", @ast.MCustom("Circle"))],
        ret_type: @ast.MInt,
        body: @ast.EInt(0),
      },
    ]),
  ]
  let result = emit_dart_program(prog)
  assert_true(result.contains("class Circle implements Drawable, Comparable"))
}

///|
test "emit_dart_program impl_no_struct" {
  let prog = [
    @ast.DTrait("Drawable", [
      { name: "draw", params: [], ret_type: @ast.MUnit, },
    ]),
    @ast.DImpl("Drawable", "Circle", [
      { name: "draw", params: [], ret_type: @ast.MUnit, body: @ast.EInt(0), },
    ]),
  ]
  let result = emit_dart_program(prog)
  assert_true(result.contains("class Circle implements Drawable"))
}
