///|
/// codegen 公共辅助函数 — 在 emitter.mbt 和 flutter_emitter.mbt 之间共享的格式化逻辑。

///|
/// 格式化 Dart 参数列表 — 将 MoonBit 参数类型映射为 Dart 类型并拼接。
#inline
fn format_dart_params(params : Array[(String, @ast.MoonType)]) -> String {
  params
  .map(fn(pair) {
    let (pname, ptype) = pair
    "\{@typesys.map_type(ptype).to_dart_string()} \{pname}"
  })
  .join(", ")
}

///|
/// 格式化泛型参数列表 — `<T, U>` 或空字符串。
#inline
fn format_generics(type_params : Array[String]) -> String {
  if type_params.length() > 0 {
    "<\{type_params.join(", ")}>"
  } else {
    ""
  }
}

///|
/// 格式化 class 字段列表 — 每行一个字段声明。
fn format_dart_fields(fields : Array[(String, @ast.MoonType)]) -> String {
  fields
  .map(fn(pair) {
    let (fname, ftype) = pair
    "  \{@typesys.map_type(ftype).to_dart_string()} \{fname};"
  })
  .join("\n")
}

///|
/// 格式化 Flutter widget 字段列表 — 使用 final 修饰符。
fn format_flutter_fields(fields : Array[(String, @ast.MoonType)]) -> String {
  fields
  .map(fn(pair) {
    let (fname, ftype) = pair
    "  final \{@typesys.map_type(ftype).to_dart_string()} \{fname};"
  })
  .join("\n")
}

///|
/// 格式化构造函数参数列表 — `required this.field` 形式。
#inline
fn format_ctor_params(fields : Array[(String, @ast.MoonType)]) -> String {
  fields
  .map(fn(pair) {
    let (fname, _) = pair
    "required this.\{fname}"
  })
  .join(", ")
}

///|
/// 生成文件头注释。
#inline
fn generate_header() -> String {
  "// Generated by moon2dart v0.9.1\n// DO NOT EDIT BY HAND\n\n"
}
