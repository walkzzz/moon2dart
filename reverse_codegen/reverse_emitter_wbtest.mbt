///|
test "reverse_codegen: dart_type_to_moon basic" {
  assert_eq(dart_type_to_moon(@dart_ast.DInt), "Int")
  assert_eq(dart_type_to_moon(@dart_ast.DDouble), "Double")
  assert_eq(dart_type_to_moon(@dart_ast.DBool), "Bool")
  assert_eq(dart_type_to_moon(@dart_ast.DString), "String")
  assert_eq(dart_type_to_moon(@dart_ast.DRune), "Char")
  assert_eq(dart_type_to_moon(@dart_ast.DVoid), "Unit")
}

///|
test "reverse_codegen: dart_type_to_moon composite" {
  assert_eq(dart_type_to_moon(@dart_ast.DList(@dart_ast.DInt)), "Array[Int]")
  assert_eq(
    dart_type_to_moon(@dart_ast.DMap(@dart_ast.DString, @dart_ast.DInt)),
    "Map[String, Int]",
  )
  assert_eq(dart_type_to_moon(@dart_ast.DSet(@dart_ast.DDouble)), "Set[Double]")
  assert_eq(
    dart_type_to_moon(@dart_ast.DNullable(@dart_ast.DInt)),
    "Option[Int]",
  )
  assert_eq(dart_type_to_moon(@dart_ast.DFuture(@dart_ast.DInt)), "Future[Int]")
  assert_eq(dart_type_to_moon(@dart_ast.DCustom("MyType")), "MyType")
}

///|
test "reverse_codegen: emit_moon_expr literals" {
  assert_eq(emit_moon_expr(@dart_ast.DIntLit(42)), "42")
  assert_eq(emit_moon_expr(@dart_ast.DBoolLit(true)), "true")
  assert_eq(emit_moon_expr(@dart_ast.DBoolLit(false)), "false")
  assert_eq(emit_moon_expr(@dart_ast.DStringLit("hello")), "\"hello\"")
  assert_eq(emit_moon_expr(@dart_ast.DNullLit), "None")
  assert_eq(emit_moon_expr(@dart_ast.DVarRef("x")), "x")
}

///|
test "reverse_codegen: emit_moon_expr binary op" {
  let expr = @dart_ast.DBinOp(
    "+",
    @dart_ast.DVarRef("a"),
    @dart_ast.DVarRef("b"),
  )
  assert_eq(emit_moon_expr(expr), "a + b")
}

///|
test "reverse_codegen: emit_moon_expr function call" {
  let expr = @dart_ast.DFunctionCall("add", [
    @dart_ast.DIntLit(1),
    @dart_ast.DIntLit(2),
  ])
  assert_eq(emit_moon_expr(expr), "add(1, 2)")
}

///|
test "reverse_codegen: emit_moon_expr method call" {
  let expr = @dart_ast.DMethodCall("obj", "toString", [])
  assert_eq(emit_moon_expr(expr), "obj.toString()")
}

///|
test "reverse_codegen: emit_moon_expr if" {
  let expr = @dart_ast.DIfExpr(
    @dart_ast.DBoolLit(true),
    @dart_ast.DIntLit(1),
    @dart_ast.DIntLit(0),
  )
  assert_eq(emit_moon_expr(expr), "if true { 1 } else { 0 }")
}

///|
test "reverse_codegen: emit_moon_expr await" {
  let expr = @dart_ast.DAwaitExpr(@dart_ast.DVarRef("future"))
  assert_eq(emit_moon_expr(expr), "await future")
}

///|
test "reverse_codegen: emit_moon_decl top-level function" {
  let decl = @dart_ast.DTopFn(
    "add",
    [],
    [("a", @dart_ast.DInt), ("b", @dart_ast.DInt)],
    @dart_ast.DInt,
    @dart_ast.DBinOp("+", @dart_ast.DVarRef("a"), @dart_ast.DVarRef("b")),
  )
  let result = emit_moon_decl(decl)
  assert_true(result.contains("fn add"))
  assert_true(result.contains("a : Int"))
  assert_true(result.contains("b : Int"))
  assert_true(result.contains("-> Int"))
  assert_true(result.contains("a + b"))
}

///|
test "reverse_codegen: emit_moon_decl sealed class" {
  let decl = @dart_ast.DSealedClass("Color", [
    @dart_ast.DartVariant::{ name: "Red", fields: [], },
    @dart_ast.DartVariant::{ name: "Blue", fields: [], },
  ])
  let result = emit_moon_decl(decl)
  assert_true(result.contains("enum Color"))
  assert_true(result.contains("Red"))
  assert_true(result.contains("Blue"))
}

///|
test "reverse_codegen: emit_moon_decl abstract class → trait" {
  let decl = @dart_ast.DAbstractClass("Named", [
    @dart_ast.DartMethod::{
      name: "name",
      params: [],
      ret_type: @dart_ast.DString,
      body: @dart_ast.DStringLit(" unnamed"),
      is_async: false,
    },
  ])
  let result = emit_moon_decl(decl)
  assert_true(result.contains("trait Named"))
  assert_true(result.contains("fn name"))
}

///|
test "reverse_codegen: emit_moon_program" {
  let decls = [
    @dart_ast.DTopFn(
      "add",
      [],
      [("a", @dart_ast.DInt), ("b", @dart_ast.DInt)],
      @dart_ast.DInt,
      @dart_ast.DBinOp("+", @dart_ast.DVarRef("a"), @dart_ast.DVarRef("b")),
    ),
  ]
  let result = emit_moon_program(decls)
  assert_true(result.contains("fn add"))
  assert_true(result.contains("Generated by moon2dart"))
}

///|
test "reverse_codegen: dart_type_to_moon_ast" {
  assert_true(dart_type_to_moon_ast(@dart_ast.DInt) is @ast.MInt)
  assert_true(dart_type_to_moon_ast(@dart_ast.DDouble) is @ast.MDouble)
  assert_true(dart_type_to_moon_ast(@dart_ast.DString) is @ast.MString)
  assert_true(dart_type_to_moon_ast(@dart_ast.DVoid) is @ast.MUnit)
  assert_true(
    dart_type_to_moon_ast(@dart_ast.DList(@dart_ast.DInt)) is @ast.MArray(_),
  )
  assert_true(
    dart_type_to_moon_ast(@dart_ast.DNullable(@dart_ast.DInt))
    is @ast.MOption(_),
  )
}
