///|
/// structure.mbt 白盒测试 — Dart 项目结构映射。

///|
/// 测试 emit_pubspec_yaml 生成 pubspec.yaml 内容。
test "emit_pubspec_yaml" {
  let project = {
    module_name: "walkzzz/moon2dart",
    version: "0.3.0",
    packages: [],
  }
  let yaml = emit_pubspec_yaml(project)
  assert_true(yaml.contains("name: walkzzz_moon2dart"))
  assert_true(yaml.contains("version: 0.3.0"))
  assert_true(yaml.contains("sdk: '>=3.0.0 <4.0.0'"))
}

///|
/// 测试 map_package_to_dart_path 映射包路径。
test "map_package_to_dart_path" {
  assert_eq(map_package_to_dart_path("root"), "lib/root.dart")
  assert_eq(map_package_to_dart_path("ast"), "lib/ast/ast.dart")
  assert_eq(map_package_to_dart_path("cmd_main"), "lib/cmd/main/cmd/main.dart")
}

///|
/// 测试 emit_dart_imports 生成 import 声明。
test "emit_dart_imports" {
  let pkg = {
    name: "root",
    path: ".",
    dependencies: ["ast", "codegen"],
    source_files: [],
  }
  let imports = emit_dart_imports(pkg)
  assert_true(imports.contains("import 'ast/ast.dart';"))
  assert_true(imports.contains("import 'codegen/codegen.dart';"))
}

///|
/// 测试 emit_dart_project_files 生成文件列表。
test "emit_dart_project_files" {
  let project = {
    module_name: "walkzzz/moon2dart",
    version: "0.3.0",
    packages: [
      { name: "root", path: ".", dependencies: [], source_files: ["main.mbt"], },
    ],
  }
  let files = emit_dart_project_files(project, fn(_path) { "dart code" })
  assert_eq(files.length(), 2)
  let (path0, _) = files[0]
  assert_eq(path0, "pubspec.yaml")
  let (path1, content1) = files[1]
  assert_eq(path1, "lib/root.dart")
  assert_true(content1.contains("Generated by moon2dart"))
  assert_true(content1.contains("dart code"))
}

///|
/// 测试 emit_dart_project_files 多包项目。
test "emit_dart_project_files_multi" {
  let project = {
    module_name: "walkzzz/moon2dart",
    version: "0.3.0",
    packages: [
      {
        name: "root",
        path: ".",
        dependencies: ["ast"],
        source_files: ["main.mbt"],
      },
      { name: "ast", path: "ast", dependencies: [], source_files: ["ast.mbt"], },
    ],
  }
  let files = emit_dart_project_files(project, fn(_path) { "dart" })
  assert_eq(files.length(), 3)
  let (p0, _) = files[0]
  assert_eq(p0, "pubspec.yaml")
  let (p1, _) = files[1]
  assert_eq(p1, "lib/root.dart")
  let (p2, _) = files[2]
  assert_eq(p2, "lib/ast/ast.dart")
}
