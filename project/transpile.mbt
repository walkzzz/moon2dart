///|
/// 多文件项目转换 — 读取源文件、解析、转换、生成 Dart 项目文件列表。

///|
/// 转换整个项目为 Dart 文件列表（async，从文件系统读取源文件）。
pub async fn transpile_project(
  project : ProjectInfo,
) -> Array[(String, String)] {
  let graph = build_dependency_graph(project.packages)
  let sorted_names = graph.topo_sort()
  let files : Array[(String, String)] = []
  files.push(("pubspec.yaml", emit_pubspec_yaml(project)))
  for pkg_name in sorted_names {
    let pkg_opt = find_package_by_name(project.packages, pkg_name)
    match pkg_opt {
      Some(p) => {
        let dart_path = map_package_to_dart_path(p.name)
        let dart_content = transpile_package_async(p)
        files.push((dart_path, dart_content))
      }
      None => ()
    }
  }
  files
}

///|
/// 按名称查找包信息。
pub fn find_package_by_name(
  packages : Array[PackageInfo],
  name : String,
) -> PackageInfo? {
  for pkg in packages {
    if pkg.name == name {
      return Some(pkg)
    }
  }
  None
}

///|
/// 转换单个包的所有源文件为 Dart 代码（async，从文件系统读取）。
async fn transpile_package_async(pkg : PackageInfo) -> String {
  let header = "// Generated by moon2dart v0.4.0\n// Package: \{pkg.name}\n// DO NOT EDIT BY HAND\n\n"
  let all_decls : Array[@ast.MoonDecl] = []
  for src_file in pkg.source_files {
    let src_path = pkg.path + "/" + src_file
    let src_content = @fs.read_file(src_path).text()
    let tokens = @parser.Lexer::make(src_content).tokenize()
    let decls = @parser.Parser::make(tokens).parse_program()
    for decl in decls {
      all_decls.push(decl)
    }
  }
  let body = @codegen.emit_dart_program(all_decls)
  "\{header}\{body}"
}

///|
/// 将 Dart 项目文件列表写入输出目录（async）。
pub async fn write_dart_project(
  files : Array[(String, String)],
  output_dir : String,
) -> Unit {
  for pair in files {
    let (path, content) = pair
    let full_path = output_dir + "/" + path

    let mut slash_idx = -1
    let chars = full_path.to_array()
    for i in 0..<full_path.length() {
      if chars[i] == '/' || chars[i] == '\\' {
        slash_idx = i
      }
    }
    if slash_idx != -1 {
      let dir = full_path[:slash_idx].to_owned()
      @fs.mkdir(dir, recursive=true, allow_exist=true)
    }
    @fs.write_file(full_path, @utf8.encode(content))
  }
}
