///|
/// Dart 项目结构映射 — 将 MoonBit 项目结构映射为 Dart 项目结构。

///|
/// 生成 pubspec.yaml 内容。
pub fn emit_pubspec_yaml(project : ProjectInfo) -> String {
  let name = project.module_name.replace(old="/", new="_")
  "name: \{name}\ndescription: Generated from MoonBit project \{project.module_name}\nversion: \{project.version}\nenvironment:\n  sdk: '>=3.0.0 <4.0.0'\n"
}

///|
/// 映射 MoonBit 包名到 Dart lib/ 路径。
pub fn map_package_to_dart_path(pkg_name : String) -> String {
  if pkg_name == "root" {
    "lib/root.dart"
  } else {
    "lib/\{pkg_name.replace(old="_", new="/")}/\{pkg_name.replace(old="_", new="/")}.dart"
  }
}

///|
/// 生成 Dart 项目文件列表（路径 + 内容）。
/// 每个文件是 (相对路径, 文件内容) 的元组。
pub fn emit_dart_project_files(
  project : ProjectInfo,
  transpile_fn : (String) -> String,
) -> Array[(String, String)] {
  let files : Array[(String, String)] = []
  files.push(("pubspec.yaml", emit_pubspec_yaml(project)))
  for pkg in project.packages {
    let dart_path = map_package_to_dart_path(pkg.name)
    let dart_content = transpile_package(pkg, transpile_fn)
    files.push((dart_path, dart_content))
  }
  files
}

///|
/// 转换单个包的所有源文件为 Dart 代码（合并为一个文件）。
fn transpile_package(
  pkg : PackageInfo,
  transpile_fn : (String) -> String,
) -> String {
  let header = "// Generated by moon2dart v0.4.0\n// Package: \{pkg.name}\n// DO NOT EDIT BY HAND\n\n"
  let mut body = ""
  for src_file in pkg.source_files {
    let src_content = transpile_fn(pkg.path + "/" + src_file)
    body = body + src_content + "\n\n"
  }
  "\{header}\{body}"
}

///|
/// 生成 Dart import 声明列表（基于包依赖关系）。
pub fn emit_dart_imports(pkg : PackageInfo) -> String {
  let mut imports = ""
  for dep in pkg.dependencies {
    let dart_path = map_package_to_dart_path(dep)
    let import_path = dart_path.replace(old="lib/", new="")
    imports = imports + "import '\{import_path}';\n"
  }
  imports
}
